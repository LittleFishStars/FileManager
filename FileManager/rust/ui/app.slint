// 文件管理器界面。
//
// 硬性约束（见项目 AGENTS.md）：
//   * 颜色一律走 Palette / Theme 全局，不硬编码色值，否则明暗与风格切换失效。
//   * 动画只用 animate（编译成渲染线程上的时间线，静止即零重绘）；禁止 Timer 插值。
//   * 不使用 width / height 的动画，只动 opacity 与颜色，避免每帧重新布局。

// 注意两件事：
//   * 明暗主题的判断走 `Palette.color-scheme`，Slint 没有 Theme 全局。
//   * ListView 来自 std-widgets，不是内置元素。
import { Button, LineEdit, ListView, Palette } from "std-widgets.slint";

// ---------------------------------------------------------------------------
// 与 Rust 侧共享的数据类型
// ---------------------------------------------------------------------------

/// 文件列表的一行。字段由 Rust 侧填充，`.slint` 只读。
export struct FileEntry {
    name: string,
    path: string,
    is-dir: bool,
    size-text: string,
    modified-text: string,
    // 图标由 Rust 侧按扩展名/目录名从 Material Icon Theme 里选好后填进来，
    // 未收录的类型回退到通用文档图标。
    icon: image,
    // 该图标是否是单色图标（Tabler 那批）。单色的用 colorize 跟随主题色；
    // Material 的多色图标不能 colorize，否则会被压成一个色块。
    icon-mono: bool,
    type-text: string,
    // 斑马纹标记：由 Rust 侧按行号填充。
    alt: bool,
}

/// 侧边栏的一项。
export struct Place {
    label: string,
    path: string,
}

// ---------------------------------------------------------------------------
// 图标
//
// 有意不用 Path 也不引入图标字体：Path 的 commands 不走 width/height 缩放，
// 而图标字体在多发行版上随时可能缺失。改用「圆角色块 + 字首字母」，
// 颜色全部来自 Palette，任何风格与明暗主题下都能正确跟随。
// ---------------------------------------------------------------------------

/// 列表行的文件/文件夹图标。
///
/// 图标本身（SVG 字节）在 Rust 侧按扩展名/目录名选好后通过 `source` 传进来，
/// 这里只负责画。22px 是列表行的图标尺寸；SVG 是矢量的，任意 DPI 都清晰。
component FileIcon inherits Rectangle {
    in property <image> source;
    in property <bool> mono: false;
    in property <color> tint: Palette.foreground;

    width: 22px;
    background: transparent;

    // 关键：布局在交叉轴上会把子元素拉伸到整行高（36px），
    // 光给 Image 设 height: 22px 没用——图标会贴在行顶部。
    // 放进一个 alignment:center 的 VerticalLayout 才会真正垂直居中。
    VerticalLayout {
        alignment: center;
        Image {
            source: root.source;
            width: 22px;
            height: 22px;
            image-fit: contain;
            // 单色图标（Tabler）按当前前景色重新上色；多色图标保持原样。
            colorize: root.mono ? root.tint : transparent;
        }
    }
}

// ---------------------------------------------------------------------------
// 列表行
// ---------------------------------------------------------------------------

component FileRow inherits Rectangle {
    in property <FileEntry> item;
    in property <bool> selected: false;
    in property <bool> hovered: false;
    // 斑马纹：奇数行给一点底色，长列表里横向扫视不容易串行。
    in property <bool> alt: false;

    callback clicked();
    callback activated();

    height: 36px;
    border-radius: 5px;
    // 三元必须单行，见文件开头的说明。
    background: selected ? Palette.selection-background : (hovered ? Palette.alternate-background : (alt ? Palette.alternate-background : transparent));
    animate background { duration: 90ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;

        FileIcon {
            source: item.icon;
            mono: item.icon-mono;
            tint: Palette.foreground;
        }

        // 文件名：占满剩余宽度，过长省略
        Text {
            text: item.name;
            color: selected ? Palette.selection-foreground : Palette.foreground;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 0px;
        }

        Text {
            text: item.type-text;
            color: Palette.foreground;
            opacity: 0.6;
            font-size: 11.5px;
            width: 96px;   // 与表头「类型」列一致
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            text: item.size-text;
            color: Palette.foreground;
            opacity: 0.7;
            font-size: 11.5px;
            width: 74px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        Text {
            text: item.modified-text;
            color: Palette.foreground;
            opacity: 0.7;
            font-size: 11.5px;
            width: 116px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    // 悬停高亮：用一个叠层而不是改背景色，这样不会与"选中"态打架
    Rectangle {
        background: Palette.foreground;
        opacity: hovered && !selected ? 0.03 : 0.0;
        border-radius: parent.border-radius;
        animate opacity { duration: 90ms; easing: ease-out; }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        double-clicked => { root.activated(); }
    }
}

// ---------------------------------------------------------------------------
// 侧边栏入口
// ---------------------------------------------------------------------------

component SideItem inherits Rectangle {
    in property <string> label;
    in property <bool> current: false;
    in property <bool> hovered: false;

    callback clicked();

    height: 34px;
    border-radius: 5px;
    background: current ? Palette.selection-background : (hovered ? Palette.alternate-background : transparent);
    animate background { duration: 90ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 12px;
        spacing: 9px;

        // 侧边栏也用 Tabler 的文件夹图标，和工具栏同一套视觉语言。
        // 同样需要 alignment:center：否则 34px 的行里 18px 图标会贴在顶部。
        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("../icons/tabler/folder.svg");
                colorize: current ? Palette.selection-foreground : Palette.foreground;
                width: 18px;
                height: 18px;
                image-fit: contain;
            }
        }
        Text {
            text: label;
            color: current ? Palette.selection-foreground : Palette.foreground;
            font-size: 13px;
            vertical-alignment: center;
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

// ---------------------------------------------------------------------------
// 导航图标：用几何图形画，不用 ←→↑ 这类字符
//
// 字符当图标有两个毛病：不同字体的字形宽高不一，观感忽大忽小；
// 而且没有任何字体保证这些码位一定存在。这里用「正方形转 45 度成三角形」凑出箭头尖。
// 注意 `transform-rotation` 是 Transform 元素的属性，不能直接写在 Rectangle 上。
// ---------------------------------------------------------------------------

/// 一个朝向某个方向的三角形。只用在小尺寸的「排序方向」指示上。
///
/// 为什么用 Path 而不是旋转 Rectangle：Slint 1.18 的 Rectangle **不支持旋转**
/// （`transform-rotation` 只属于内部的 Transform 类型，`rotation-angle` 是它已废弃的别名）。
/// Path 的 commands 用元素自身坐标系里的绝对像素，所以这里按 side 换算顶点。
/// 注意：长度转字符串要先除以 1px；Path 里面也不能放子元素。
component AngleTri inherits Path {
    in property <length> side: 7px;
    in property <color> tint: Palette.foreground;
    /// 0 上尖 1 下尖 2 左尖 3 右尖
    in property <int> dir: 1;

    width: side;
    height: side;
    fill: tint;
    commands: root.dir == 0 ? "M " + (root.side / 2px) + " 0 L " + (root.side / 1px) + " " + (root.side / 1px) + " L 0 " + (root.side / 1px) + " Z"
            : root.dir == 1 ? "M 0 0 L " + (root.side / 1px) + " 0 L " + (root.side / 2px) + " " + (root.side / 1px) + " Z"
            : root.dir == 2 ? "M " + (root.side / 1px) + " 0 L " + (root.side / 1px) + " " + (root.side / 1px) + " L 0 " + (root.side / 2px) + " Z"
            : "M 0 0 L " + (root.side / 1px) + " " + (root.side / 2px) + " L 0 " + (root.side / 1px) + " Z";
}

// 关于导航图标的一个决定：这里本来用几何图形画 ←→↑ 箭头，实测做不好——
// Slint 的 Rectangle 不能旋转，折线箭头只能用矩形拼，拼出来的形状在小尺寸下
// 又钝又难辨认（还出现过方向反了的问题）。所以工具栏统一改回**文字按钮**：
// 中文标签在任何字体下都清晰，也不用为了一个图标引入图标字体。
// ---------------------------------------------------------------------------
// 界面图标按钮（Tabler Icons）
//
// Tabler 的 outline 图标是单色的，统一用 colorize 换成主题前景色，
// 深浅主题与 Fluent/Material 换肤都会自动跟随，不需要第二套图标。
// @image-url 只接受编译期静态路径，写不成 @image-url(root.name)，
// 所以这里按名字显式分发；对外仍然只是一个名字字符串。
// ---------------------------------------------------------------------------
component IconButton inherits Rectangle {
    in property <string> name;
    /// 悬停提示。图标没有文字，提示就是它的可读名。
    in property <string> tip;
    in property <bool> enabled: true;
    in property <bool> hovered: false;

    callback clicked();

    width: 34px;
    height: 34px;
    border-radius: 6px;
    background: hovered && enabled ? Palette.alternate-background : transparent;
    animate background { duration: 90ms; easing: ease-out; }

    // 每个分支用显式尺寸与位置（不引用 parent：组件体内 parent 不一定可访问）
    if name == "ui-arrow-left" : Image { source: @image-url("../icons/tabler/arrow-left.svg"); colorize: Palette.foreground; opacity: root.enabled ? 1.0 : 0.32; x: 7px; y: 7px; width: 20px; height: 20px; image-fit: contain; }
    if name == "ui-arrow-right" : Image { source: @image-url("../icons/tabler/arrow-right.svg"); colorize: Palette.foreground; opacity: root.enabled ? 1.0 : 0.32; x: 7px; y: 7px; width: 20px; height: 20px; image-fit: contain; }
    if name == "ui-arrow-up" : Image { source: @image-url("../icons/tabler/arrow-up.svg"); colorize: Palette.foreground; opacity: root.enabled ? 1.0 : 0.32; x: 7px; y: 7px; width: 20px; height: 20px; image-fit: contain; }
    if name == "ui-refresh" : Image { source: @image-url("../icons/tabler/refresh.svg"); colorize: Palette.foreground; opacity: root.enabled ? 1.0 : 0.32; x: 7px; y: 7px; width: 20px; height: 20px; image-fit: contain; }
    if name == "ui-folder-plus" : Image { source: @image-url("../icons/tabler/folder-plus.svg"); colorize: Palette.foreground; opacity: root.enabled ? 1.0 : 0.32; x: 7px; y: 7px; width: 20px; height: 20px; image-fit: contain; }
    if name == "ui-trash" : Image { source: @image-url("../icons/tabler/trash.svg"); colorize: Palette.foreground; opacity: root.enabled ? 1.0 : 0.32; x: 7px; y: 7px; width: 20px; height: 20px; image-fit: contain; }
    if name == "ui-eye" : Image { source: @image-url("../icons/tabler/eye.svg"); colorize: Palette.foreground; opacity: root.enabled ? 1.0 : 0.32; x: 7px; y: 7px; width: 20px; height: 20px; image-fit: contain; }
    if name == "ui-eye-off" : Image { source: @image-url("../icons/tabler/eye-off.svg"); colorize: Palette.foreground; opacity: root.enabled ? 1.0 : 0.32; x: 7px; y: 7px; width: 20px; height: 20px; image-fit: contain; }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

/// 表头单元：列宽、对齐方式、可排序都在这里定义，
/// 和 FileRow 里的同名列共用同一组宽度常量，避免两处各写一份而对不齐。
component SortHeader inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> descending: false;
    in property <bool> right-aligned: false;
    in property <length> cell-width: 110px;
    in property <bool> hovered: false;

    callback clicked();

    // 列宽由调用方给死。表头与 FileRow 必须用同一组数值，
    // 任何一边单独调宽都会错位，所以两处的宽度都写在这里的注释旁边。
    width: cell-width;
    height: 22px;
    // 排序激活态**不用底色**表示：整块涂成选中色会让列头看起来像个按下的按钮，
    // 也和真正被选中的行抢注意力。激活态只靠「文字变亮 + 出现方向箭头」表达。
    border-radius: 4px;
    background: hovered ? Palette.alternate-background : transparent;
    animate background { duration: 90ms; easing: ease-out; }

    HorizontalLayout {
        // 排序方向三角：只在激活时存在，未激活就不占间距
        spacing: 4px;
        if active : AngleTri {
            side: 7px;
            tint: Palette.selection-foreground;
            dir: descending ? 1 : 0;
            opacity: 0.9;
        }
        Text {
            text: label;
            color: active ? Palette.selection-foreground : Palette.foreground;
            opacity: active ? 1.0 : 0.6;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-alignment: right-aligned ? right : left;
            horizontal-stretch: 1;
            min-width: 0px;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "文件管理器";
    preferred-width: 1040px;
    preferred-height: 660px;
    min-width: 520px;
    min-height: 380px;

    // 由 Rust 侧在启动时填入
    in-out property <[Place]> places: [];
    in-out property <[FileEntry]> files: [];
    in-out property <string> current-path: "";
    in-out property <string> status-text: "";
    in-out property <int> selected-index: -1;
    in-out property <bool> can-go-back: false;
    in-out property <bool> can-go-forward: false;
    in-out property <bool> can-go-up: false;
    in-out property <bool> show-hidden: false;
    in-out property <int> sort-mode: 0;      // 0 名称 1 大小 2 修改时间 3 类型
    in-out property <bool> sort-descending: false;
    in-out property <string> search-query: "";
    in-out property <string> rename-value: "";
    // 编译期烘焙进来的风格名，由 Rust 侧启动时填入（状态栏显示用）。
    in-out property <string> style-name: "";
    // 列表为空时的提示文案，由 Rust 侧填入。
    // 之前这里直接复用 status-text，结果「某目录无匹配项」时会把这句
    // 状态栏文案同时画在列表中间，看起来像渲染残留。
    in-out property <string> empty-message: "空目录";
    // 未收录类型用的通用文件图标，由 Rust 侧启动时填入。
    // 放在顶层属性而不是让每行回退，是为了避免 ListView 每构造一行就重新解析 SVG。
    in-out property <image> default-icon;

    callback navigate(string);
    callback go-back();
    callback go-forward();
    callback go-up();
    callback refresh();
    callback toggle-hidden();
    callback set-sort(int, bool);
    callback open-selected();
    callback open-external(string);
    callback search-edited(string);
    callback rename-selected(string);
    callback delete-selected();
    callback create-folder();

    background: Palette.background;

    // 窗口整体内缩一圈。
    // niri 不提供服务端窗口装饰，所以内容会直接顶到窗口边缘：最上面的按钮贴着屏幕
    // 上沿、分隔线压到左右边缘，观感就是「四周太挤、像被裁掉」。这里给根布局统一
    // 留出外边距，窗口底色仍然铺满整个窗口，所以内缩区看起来只是一圈背景。
    VerticalLayout {
        padding: 10px;
        spacing: 0px;

        // -------------------------------------------------------------------
        // 顶栏：导航按钮 + 地址栏 + 新建/隐藏/排序
        // -------------------------------------------------------------------
        Rectangle {
            height: 56px;
            background: Palette.background;

            HorizontalLayout {
                // 顶栏四周都要留出余量：之前左右各 10px、按钮间距 4px，
                // 四个按钮挤成一串，紧贴窗口上沿和左沿，观感就是「贴到一起」。
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 10px;

                // 导航与操作图标全部来自 Tabler Icons
                IconButton { name: "ui-arrow-left"; tip: "后退"; enabled: root.can-go-back; clicked => { root.go-back(); } }
                IconButton { name: "ui-arrow-right"; tip: "前进"; enabled: root.can-go-forward; clicked => { root.go-forward(); } }
                IconButton { name: "ui-arrow-up"; tip: "上级"; enabled: root.can-go-up; clicked => { root.go-up(); } }
                IconButton { name: "ui-refresh"; tip: "刷新"; clicked => { root.refresh(); } }

                Rectangle { width: 8px; background: transparent; }

                // 地址条：只读展示。
                // 用 Palette.alternate-background 而不是描边 + 底色，视觉上更安静，
                // 也避免描边在分数缩放下出现半个像素的模糊边。
                Rectangle {
                    horizontal-stretch: 1;
                    height: 30px;
                    border-radius: 6px;
                    background: Palette.alternate-background;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Image {
                            source: @image-url("../icons/tabler/folder.svg");
                            colorize: Palette.foreground;
                            width: 16px;
                            height: 16px;
                            image-fit: contain;
                        }
                        Text {
                            text: root.current-path;
                            color: Palette.foreground;
                            font-size: 12.5px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                            min-width: 0px;
                        }
                    }
                }

                Rectangle { width: 4px; background: transparent; }

                // 隐藏项开关：睁眼＝隐藏项可见，闭眼＝已过滤
                IconButton {
                    name: root.show-hidden ? "ui-eye" : "ui-eye-off";
                    tip: root.show-hidden ? "隐藏项：显示中" : "隐藏项：已过滤";
                    clicked => { root.toggle-hidden(); }
                }
                IconButton { name: "ui-folder-plus"; tip: "新建文件夹"; clicked => { root.create-folder(); } }
            }
        }

        // 分隔线：用 Palette.border，深浅主题自动跟随
        Rectangle { height: 1px; background: Palette.border; }

        // -------------------------------------------------------------------
        // 主体：侧边栏 + 文件列表
        // -------------------------------------------------------------------
        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            // 侧边栏
            Rectangle {
                width: 186px;
                background: Palette.background;

                VerticalLayout {
                    // 侧边栏内边距比正文大一档：窗口左沿到内容距离太小时，
                    // 首行的图标看着像贴在边框上。
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 2px;

                    // 应用标识：九个点组成的矩阵，纯几何，不依赖图片或字体
                    HorizontalLayout {
                        height: 44px;
                        padding-left: 4px;
                        spacing: 12px;
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: 6px;
                            background: Palette.accent-background;
                            // Slint 的 for 不能嵌套，所以九个点显式写出来。
                            // 全部用 Palette.accent-foreground，硬编码的只有几何位置。
                            for col[j] in 3 : Rectangle { x: 6px + j * 5px; y: 6px;  width: 3.5px; height: 3.5px; border-radius: 1.75px; background: Palette.accent-foreground; }
                            for col[j] in 3 : Rectangle { x: 6px + j * 5px; y: 11px; width: 3.5px; height: 3.5px; border-radius: 1.75px; background: Palette.accent-foreground; }
                            for col[j] in 3 : Rectangle { x: 6px + j * 5px; y: 16px; width: 3.5px; height: 3.5px; border-radius: 1.75px; background: Palette.accent-foreground; }
                        }
                        Text {
                            text: "文件管理器";
                            color: Palette.foreground;
                            font-size: 13.5px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    for place in root.places : SideItem {
                        label: place.label;
                        current: root.current-path == place.path;
                        clicked => { root.navigate(place.path); }
                    }

                    Rectangle { vertical-stretch: 1; background: transparent; }

                    Text {
                        text: root.show-hidden ? "已显示隐藏项" : "隐藏项已过滤";
                        color: Palette.foreground;
                        opacity: 0.45;
                        font-size: 11px;
                        horizontal-alignment: left;
                    }
                }
            }

            Rectangle { width: 1px; background: Palette.border; }

            // 右侧：搜索 + 表头 + 列表
            VerticalLayout {
                spacing: 0px;
                horizontal-stretch: 1;

                Rectangle {
                    height: 42px;
                    background: Palette.background;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;

                        // 这个输入框同时承担两件事：搜索，以及**中文输入法的实测入口**
                        LineEdit {
                            placeholder-text: "搜索当前目录（也可在此实测中文输入法）";
                            text <=> root.search-query;
                            edited => { root.search-edited(self.text); }
                            horizontal-stretch: 1;
                        }

                        // 重命名：选中一行后在此输入新名字并回车
                        LineEdit {
                            placeholder-text: "重命名";
                            text <=> root.rename-value;
                            width: 170px;
                            accepted => {
                                root.rename-selected(self.text);
                                self.text = "";
                            }
                        }

                        IconButton { name: "ui-trash"; tip: "移入回收站"; clicked => { root.delete-selected(); } }
                    }
                }

                // 表头
                Rectangle {
                    height: 28px;
                    background: Palette.background;

                    HorizontalLayout {
                        padding-left: 46px;   // FileRow: 12 行内边距 + 22 图标 + 12 间距 = 46
                        padding-right: 10px;
                        spacing: 10px;


                        // 列头本身就是排序控件：点一下切字段，再点同字段切升降序。
                        // 名称列用固定宽度，**不能**写成 parent.width - 常量：
                        // 那会让列宽依赖自身所在的布局宽度，形成循环绑定，Slint 直接报 Recursion detected。
                        SortHeader {
                            label: "名称"; cell-width: 280px;
                            active: sort-mode == 0; descending: sort-descending;
                            clicked => { root.set-sort(0, !(sort-mode == 0 && !sort-descending)); }
                        }
                        SortHeader {
                            label: "类型"; cell-width: 96px;
                            active: sort-mode == 3; descending: sort-descending;
                            clicked => { root.set-sort(3, !(sort-mode == 3 && !sort-descending)); }
                        }
                        SortHeader {
                            label: "大小"; cell-width: 74px; right-aligned: true;
                            active: sort-mode == 1; descending: sort-descending;
                            clicked => { root.set-sort(1, !(sort-mode == 1 && !sort-descending)); }
                        }
                        SortHeader {
                            label: "修改时间"; cell-width: 116px; right-aligned: true;
                            active: sort-mode == 2; descending: sort-descending;
                            clicked => { root.set-sort(2, !(sort-mode == 2 && !sort-descending)); }
                        }
                    }
                }

                Rectangle { height: 1px; background: Palette.border; }

                // 文件列表：ListView 只实例化可见行的 delegate
                Rectangle {
                    vertical-stretch: 1;
                    background: Palette.background;

                    if root.files.length == 0 : VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text {
                            text: root.empty-message;
                            color: Palette.foreground;
                            opacity: 0.5;
                            font-size: 13px;
                            horizontal-alignment: center;
                        }
                    }

                    ListView {
                        y: 4px;
                        height: parent.height - 8px;
                        width: parent.width;
                        for item[index] in root.files : FileRow {
                            item: item;
                            selected: index == root.selected-index;
                            // 斑马纹的奇偶由 Rust 侧在构造条目时算好，
                            // Slint 既没有 `%` 也没有 `&`，不适合在界面里推导。
                            alt: item.alt;
                            clicked => { root.selected-index = index; }
                            activated => { root.selected-index = index; root.open-selected(); }
                        }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Palette.border; }

        // -------------------------------------------------------------------
        // 状态栏
        // -------------------------------------------------------------------
        Rectangle {
            height: 30px;
            background: Palette.background;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 12px;

                Text {
                    text: root.status-text;
                    color: Palette.foreground;
                    opacity: 0.65;
                    font-size: 11.5px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    min-width: 0px;
                    overflow: elide;
                }

                // 明确标出当前风格，避免"以为在测 Material 其实跑的是 Fluent"
                Text {
                    text: Palette.color-scheme == ColorScheme.dark ? "风格: " + root.style-name + " · 深色" : "风格: " + root.style-name + " · 浅色";
                    color: Palette.foreground;
                    opacity: 0.45;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }
    }
}
